{
  "name": "@calibrate/local-runtime-config",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "nx": {
    "targets": {
      "demo-setup": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "packages/local-runtime-config",
          "command": "tsx src/local-demo-setup.ts"
        }
      },
      "demo-reset": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "packages/local-runtime-config",
          "command": "tsx src/local-demo-reset.ts"
        }
      },
      "demo-dev": {
        "executor": "nx:run-commands",
        "continuous": true,
        "cache": false,
        "options": {
          "cwd": "packages/local-runtime-config",
          "command": "tsx src/local-demo-dev.ts"
        }
      },
      "demo-reset": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "packages/local-runtime-config",
          "command": "tsx src/local-demo-reset.ts"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "options": {
          "cwd": "packages/local-runtime-config",
          "command": "vitest run src"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "cache": true,
        "options": {
          "cwd": "packages/local-runtime-config",
          "command": "oxlint --type-aware --type-check --tsconfig tsconfig.json src"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "cache": true,
        "options": {
          "command": "oxlint --config .oxlintrc.json packages/local-runtime-config"
        }
      },
      "fmt": {
        "executor": "nx:run-commands",
        "cache": true,
        "options": {
          "command": "oxfmt packages/local-runtime-config"
        }
      },
      "fmt:check": {
        "executor": "nx:run-commands",
        "cache": true,
        "options": {
          "command": "oxfmt --check packages/local-runtime-config"
        }
      }
    }
  }
}
